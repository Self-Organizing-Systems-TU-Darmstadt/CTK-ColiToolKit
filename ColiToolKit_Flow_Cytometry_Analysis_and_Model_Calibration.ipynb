    "## Define Models"
   ]
  },
  {
   "cell_type": "code",
   "id": "d23a7bcb-8f44-4f3f-ab6d-0315a6436425",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-06-02T14:51:57.713103Z",
