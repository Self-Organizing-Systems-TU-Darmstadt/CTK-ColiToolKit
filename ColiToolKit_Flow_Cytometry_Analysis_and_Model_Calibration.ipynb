   "source": [
    "def activatory_hill_equation(x, params):\n",
    "    ymax, ymin, n, k = params\n",
    "    y = ymin + (ymax - ymin) / (1 + np.power(k / x, n))\n",
    "    return y\n",
    "\n",
    "\n",
    "def inhibitory_hill_equation(x, params):\n",
    "    ymax, ymin, n, k = params\n",
    "    y = ymin + (ymax - ymin) / (1 + np.power(x / k, n))\n",
    "    return y"
   ],
   "outputs": [],
